{
  "name": "content-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "多平台内容生产工作台 · AKA张猩猩",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@mozilla/readability": "^0.5.0",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "jsdom": "^25.0.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  }
}
